includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # CLAUDE.md §3: highest reachable level, target 8.
    level: 8

    tmpDir: storage/framework/cache/phpstan

    ignoreErrors:
        # Owner scope prepared in PR-02 (D-215), first used by clients in slice F3.
        # When a model uses it this ignore becomes unmatched and Larastan asks to remove it.
        -
            identifier: trait.unused
            path: app/Models/Concerns/HasOwner.php
