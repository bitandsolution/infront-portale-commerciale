APP_NAME="Portale Commerciale Infront"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

# Password hashing: Argon2id (D-214, progettazione-tecnica §5.4.2), parameters in config/hashing.php

# Fictitious users of the local seeder (APP_ENV=local only, never on a server): one known password
# and one shared TOTP key (base32, at least 16 characters) for the managers and the first agent.
# Empty: random passwords and no two-factor key. See docs/dev/ambiente-locale.md.
DEV_USERS_PASSWORD=
DEV_USERS_TOTP_SECRET=

# Log giornalieri in storage/logs, conservati 30 giorni (PR-09, §5.2.7). In produzione LOG_LEVEL=info.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Errori su Sentry (PR-09, D-179): DSN di un'organizzazione con dati nella regione UE
# (…ingest.de.sentry.io). Vuoto = Sentry spento (sviluppo, CI). Nessun dato personale (config/sentry.php).
SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# MariaDB 11.8 (Sail: servizio "mariadb")
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=infront_portale
DB_USERNAME=sail
DB_PASSWORD=password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_uca1400_ai_ci

# Produzione (R7, D-283; docs/dev/database-utenti.md): DB_USERNAME è l'utente applicativo senza
# permessi DDL; le migrazioni girano con "php artisan migrate --database=migrator"; la conservazione
# dell'audit (audit:prune) con l'utente di manutenzione. Vuoti in sviluppo e in CI: si usa DB_USERNAME.
# DB_MIGRATION_USERNAME=
# DB_MIGRATION_PASSWORD=
# DB_AUDIT_MAINTENANCE_USERNAME=
# DB_AUDIT_MAINTENANCE_PASSWORD=

# Giorni dopo i quali si svuota l'IP degli eventi di accesso (D-211); predefinito 5 anni
# AUDIT_IP_RETENTION_DAYS=1826

# Sessioni, cache e code su Redis (D-176, D-220)
SESSION_DRIVER=redis
# Redis keeps a session for 8 hours (the agent's limit); the idle limit of each role (8 h agent,
# 2 h admin and manager, D-214) is applied by App\Http\Middleware\EnforceIdleTimeout.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produzione e staging (HTTPS): true, il cookie di sessione viaggia solo su HTTPS (D-176)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disco privato dei file caricati e generati (C10, D-218): vuoto = storage/app/private/files
FILES_ROOT=
QUEUE_CONNECTION=redis
# Code documents, mail e default con Horizon (D-220, PR-08): worker con "php artisan horizon",
# pannello su /horizon solo per l'admin. Configurazione in config/horizon.php.
CACHE_STORE=redis

# Salute interna (PR-09, §5.2.7): /health risponde 200 "ok" o 503 "fail"; dettagli con
# "php artisan health:check". Soglie predefinite in config/health.php.
# HEALTH_MAX_QUEUE_WAIT_SECONDS=600
# HEALTH_MAX_DISK_USED_PERCENT=80
# HEALTH_MAX_SCHEDULER_SILENCE_SECONDS=600

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# In sviluppo e staging le e-mail sono intercettate da Mailpit. Servizio di invio di produzione
# ancora da decidere (D-180); il mittente è unico per tutte le e-mail del portale (M01 §7).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Font dei documenti (D-249): cartella con i file Interstate, mai nel repository
DOCUMENT_FONTS_PATH=

VITE_APP_NAME="${APP_NAME}"
